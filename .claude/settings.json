{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Read(*.tsx)",
      "Read(*.ts)",
      "Read(*.css)",
      "Read(*.mjs)",
      "Read(package.json)",
      "Read(pnpm-lock.yaml)",
      "Read(README.md)",
      "Read(constitution.md)",
      "Read(specs/**)",
      "Grep",
      "Glob",
      "LS",
      "Bash(pnpm:build)",
      "Bash(pnpm:dev)",
      "Bash(pnpm:add:*)",
      "Bash(pnpm:lint)",
      "Bash(git:add:*)",
      "Write",
      "Edit",
      "MultiEdit",
      "Bash(pnpm:install)"
    ],
    "ask": [
      "Bash(git:push:*)",
      "Bash(git:commit:*)",
      "Bash(rm:*)",
      "WebFetch"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(*.pem)",
      "Read(*.key)"
    ]
  }
}