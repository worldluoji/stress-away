# Default AI Model (deepseek or minimax)
DEFAULT_MODEL=deepseek

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MiniMax API Key
MINIMAX_API_KEY=your_minimax_api_key_here

# MySQL Database (for production)
# 详情参考 sql/migrations/001_initial.sql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=stress_away
MYSQL_USE_SSL=false

# 每日免费对话次数（登录用户每日 N 次免费对话，超限付费用户确认后扣购买次数）
CHAT_FREE_PER_DAY=10

ADMIN_USERNAME=admin        # 管理员用户名，自己定                                                     
ADMIN_PASSWORD=你选的强密码   # 初始密码   