# Default AI Model (deepseek or minimax)
DEFAULT_MODEL=deepseek

# DeepSeek API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MiniMax API Key
MINIMAX_API_KEY=your_minimax_api_key_here

# MySQL Database (for production)
# 详情参考 sql/migrations/001_initial.sql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=stress_away
MYSQL_USE_SSL=false

# Upstash Redis (for production, optional - MySQL takes priority)
UPSTASH_REDIS_REST_URL=your_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Free tier limits
FREE_LIMIT_PER_DAY=1
PAID_LIMIT=50

# MBAODU (activation code via mbaodu.com)
MBAODU_APP_KEY=your_mbaodu_app_key_here

# Admin accounts (comma-separated TCB user IDs)
# Get uid from TCB console or from user login response
ADMIN_UIDS=your_tcb_uid_here

# Tencent CloudBase (TCB) Auth
# Get from: https://tcb.cloud.tencent.com/dev#/env/apikey
NEXT_PUBLIC_TCB_ENV_ID=your_tcb_env_id_here
NEXT_PUBLIC_TCB_ACCESS_KEY=your_tcb_publishable_key_here
TCB_SECRET_KEY=your_tcb_secret_key_here